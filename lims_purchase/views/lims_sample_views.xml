<odoo>
    <record id="view_lims_sample_form_inherit_purchase" model="ir.ui.view">
        <field name="name">lims.sample.form.inherit.purchase</field>
        <field name="model">lims.sample</field>
        <field name="inherit_id" ref="lims.lims_sample_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_purchase_orders"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart"
                >
                    <field
                        name="purchase_order_count"
                        widget="statinfo"
                        string="Purchase Orders"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
