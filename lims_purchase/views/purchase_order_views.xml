<odoo>
    <record id="view_purchase_order_form_inherit_lims" model="ir.ui.view">
        <field name="name">purchase.order.form.lims</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="lims_sample_id" options="{'no_create': True}" />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_linked_lims_sample"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-flask"
                    invisible="not lims_sample_id"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">LIMS Sample</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
