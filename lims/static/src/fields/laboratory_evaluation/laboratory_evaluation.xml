    <t t-name="lims.LaboratoryEvaluationField" owl="1">
        <div>
            <span class="text-success fw-bold" t-if="value === 'valid'">=</span>
            <i class="fa fa-angle-down text-warning" t-elif="value === 'min_warning'" />
            <i class="fa fa-angle-double-down text-danger" t-elif="value === 'min'" />
            <i class="fa fa-angle-up text-warning" t-elif="value === 'max_warning'" />
            <i class="fa fa-angle-double-up text-danger" t-elif="value === 'max'" />
        </div>
    </t>
</templates>
