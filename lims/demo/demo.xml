<odoo noupdate="1">
    <record model="res.partner" id="lims_demo_laboratory">
        <field name="name">Demo Laboratory</field>
        <field name="parent_id" ref="base.main_partner" />
    </record>
    <record model="lims.sample.type" id="lims_water_sample_type">
        <field name="name">Water</field>
    </record>
    <record model="lims.sample.type" id="lims_blood_sample_type">
        <field name="name">Blood</field>
    </record>
    <record model="lims.analyte" id="lims_calcium">
        <field name="name">Calcium</field>
        <field name="uom_id" ref="product_uom_mg" />
        <field name="code">Ca</field>
    </record>
    <record model="lims.analyte.specs" id="lims_calcium_spec">
        <field name="analyte_id" ref="lims_calcium" />
        <field name="sample_type_id" ref="lims_water_sample_type" />
        <field name="min_value" eval="9" />
        <field name="min_warning_value" eval="9.5" />
        <field name="min_operator">lt</field>
        <field name="max_value" eval="11" />
        <field name="max_warning_value" eval="10.5" />
        <field name="max_operator">gt</field>
    </record>
    <record model="lims.analyte" id="lims_magnesium">
        <field name="name">Magnesium</field>
        <field name="uom_id" ref="product_uom_mg" />
        <field name="code">Mg</field>
    </record>
    <record model="lims.analyte.specs" id="lims_magnesium_spec">
        <field name="analyte_id" ref="lims_magnesium" />
        <field name="sample_type_id" ref="lims_water_sample_type" />
        <field name="min_value" eval="9" />
        <field name="min_warning_value" eval="9.5" />
        <field name="min_operator">lt</field>
        <field name="max_value" eval="11" />
        <field name="max_warning_value" eval="10.5" />
        <field name="max_operator">gt</field>
    </record>
    <record model="lims.analyte" id="lims_total_hardness">
        <field name="name">Total Hardness</field>
        <field name="uom_id" ref="product_uom_mg" />
        <field name="code">THCaCO3</field>
    </record>
    <record model="lims.analyte.specs" id="lims_total_hardness_spec">
        <field name="analyte_id" ref="lims_total_hardness" />
        <field name="sample_type_id" ref="lims_water_sample_type" />
        <field name="min_value" eval="9" />
        <field name="min_warning_value" eval="9.5" />
        <field name="min_operator">lt</field>
        <field name="max_value" eval="11" />
        <field name="max_warning_value" eval="10.5" />
        <field name="max_operator">gt</field>
    </record>
    <record model="lims.analyte" id="lims_ph">
        <field name="name">pH</field>
        <field name="uom_id" ref="product_uom_mg" />
        <field name="code">pH</field>
    </record>
    <record model="lims.analyte.specs" id="lims_ph_blood_spec">
        <field name="analyte_id" ref="lims_ph" />
        <field name="sample_type_id" ref="lims_blood_sample_type" />
        <field name="min_value" eval="7.35" />
        <field name="min_warning_value" eval="7.35" />
        <field name="min_operator">lt</field>
        <field name="max_value" eval="7.45" />
        <field name="max_warning_value" eval="7.45" />
        <field name="max_operator">gt</field>
    </record>
</odoo>
