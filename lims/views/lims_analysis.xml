<odoo>
    <record model="ir.ui.view" id="lims_analysis_form_view">
        <field name="name">lims.analysis.form (in lims)</field>
        <field name="model">lims.analysis</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field
                        name="stage_id"
                        widget="statusbar"
                        options="{'fold_field': 'fold'}"
                        readonly="1"
                    />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box" />
                    <div class="oe_title">
                        <label for="identifier" />
                        <h1>
                            <field name="identifier" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <field name="sample_id" />
                        <field name="company_id" />
                        <field name="progress" widget="progressbar" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record model="ir.ui.view" id="lims_analysis_search_view">
        <field name="name">lims.analysis.search (in lims)</field>
        <field name="model">lims.analysis</field>
        <field name="arch" type="xml">
            <search>
                <field name="identifier" />
                <group expand="1" string="Group By">
                    <filter
                        name="group_stage"
                        string="Stage"
                        context="{'group_by': 'stage_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record model="ir.ui.view" id="lims_analysis_list_view">
        <field name="name">lims.analysis.list (in lims)</field>
        <field name="model">lims.analysis</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="identifier" column_invisible="1" />
                <field name="is_first_stage" column_invisible="1" />
                <field name="can_analyze" column_invisible="1" />
                <field name="can_retract" column_invisible="1" />
                <field name="can_reject" column_invisible="1" />
                <field
                    name="product_id"
                    context="{'default_laboratory_ok': True, 'default_sale_ok':False, 'default_purchase_ok':False}"
                    options="{'no_quick_create': true}"
                    readonly="not is_first_stage"
                />
                <field name="name" readonly="not is_first_stage" />
                <field name="value" readonly="not can_analyze" />
                <field
                    name="uom_id"
                    readonly="not is_first_stage"
                    groups="uom.group_uom"
                />
                <field name="stage_id" readonly="1" />
                <field name="progress" widget="progressbar" />
                <field name="can_verify" column_invisible="1" />
                <button
                    name="analyze_action"
                    groups="lims.group_lims_analyst"
                    type="object"
                    icon="fa-check-square-o"
                    title="Analyze"
                    invisible="not can_analyze"
                />
                <button
                    name="verify_action"
                    groups="lims.group_lims_verifier"
                    type="object"
                    title="Verify"
                    icon="fa-check-circle-o"
                    invisible="not can_verify"
                />
                <button
                    name="retract_action"
                    groups="lims.group_lims_verifier"
                    type="object"
                    title="Retract"
                    icon="fa-undo"
                    invisible="not can_retract"
                />
                <button
                    name="reject_action"
                    groups="lims.group_lims_analyst,lims.group_lims_verifier"
                    type="object"
                    title="Reject"
                    icon="fa-times-circle"
                    invisible="not can_reject"
                />
            </list>
        </field>
    </record>
    <record model="ir.actions.act_window" id="lims_analysis_act_window">
        <field name="name">Analysis</field>
        <field name="res_model">lims.analysis</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
</odoo>
