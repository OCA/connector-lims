<odoo>
    <!-- Operations -->
    <record id="lims_order_form" model="ir.ui.view">
        <field name="name">lims.order.form</field>
        <field name="model">lims.order</field>
        <field name="arch" type="xml">
            <form string="Analysis">
                <header>
                    <field name="team_id" invisible="1" />
                    <button
                        id="action_complete"
                        name="action_complete"
                        string="Complete"
                        class="oe_highlight"
                        type="object"
                        groups="lims.group_lims_user"
                        invisible="is_closed"
                    />
                    <button
                        id="action_cancel"
                        name="action_cancel"
                        string="Cancel Analysis"
                        type="object"
                        groups="lims.group_lims_user"
                        invisible="is_closed"
                    />
                    <field
                        name="stage_id"
                        widget="statusbar"
                        options="{'fold_field': 'fold', 'clickable': True}"
                        domain="[('stage_type', '=', 'order'), '|', ('team_ids', 'in', team_id), ('team_ids', '=', False)]"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="template_id"
                                groups="lims.group_lims_template"
                            />
                            <field name="partner_id" />
                            <field name="operator_id" />
                            <field name="specimen_id" />
                            <field name="priority" widget="priority" />
                        </group>
                        <group>
                            <field name="scheduled_date" />
                            <field name="date" />
                            <field name="team_id" groups="lims.group_lims_team" />
                            <field
                                name="category_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color'}"
                                groups="lims.group_lims_category"
                            />
                            <field
                                name="tag_ids"
                                widget="many2many_tags"
                                groups="lims.group_lims_tag"
                                options="{'color_field': 'color', 'no_create_edit': True}"
                            />
                            <field
                                name="instrument_id"
                                groups="lims.group_lims_instrument"
                                options="{'no_create': True}"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Tests" name="tests">
                            <field name="test_ids">
                                <list>
                                    <field name="name" />
                                    <field name="scheduled_date" />
                                    <field name="test_id" />
                                    <field name="operator_id" />
                                    <field
                                        name="instrument_id"
                                        groups="lims.group_lims_instrument"
                                    />
                                    <field
                                        name="batch_id"
                                        groups="lims.group_lims_batch"
                                    />
                                    <field name="stage_id" />
                                </list>
                            </field>
                        </page>
                        <page string="Other info" name="other_info">
                            <group>
                                <group name="other-left">
                                    <field
                                        name="laboratory_id"
                                        groups="lims.group_lims_laboratory"
                                    />
                                    <field
                                        name="company_id"
                                        options="{'no_create': True}"
                                        groups="base.group_multi_company"
                                    />
                                </group>
                                <group name="other-right" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="lims_order_list_view" model="ir.ui.view">
        <field name="name">lims.order.list</field>
        <field name="model">lims.order</field>
        <field name="arch" type="xml">
            <list name="orders" default_order="scheduled_date">
                <field name="scheduled_date" />
                <field name="name" />
                <field name="operator_id" />
                <field name="stage_id" string="Stage" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="action_lims_operation_order" model="ir.actions.act_window">
        <field name="name">Analysis</field>
        <field name="res_model">lims.order</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an Analysis.
            </p>
        </field>
    </record>

    <!-- Dashboard -->
    <record id="lims_order_kanban_view" model="ir.ui.view">
        <field name="name">lims.order.kanban</field>
        <field name="model">lims.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column">
                <field
                    name="stage_id"
                    options='{"group_by_tooltip": {"description": "Description"}}'
                />
                <field name="name" />
                <field name="priority" />
                <field name="operator_id" />
                <field name="color" />
                <templates>
                    <t t-name="kanban-menu">
                        <div class="container">
                            <div class="o_kanban_card_manage_settings row">
                                <div role="menuitem" aria-haspopup="true" class="col-6">
                                    <ul
                                        class="oe_kanban_colorpicker"
                                        data-field="color"
                                        role="popup"
                                    />
                                </div>
                                <div role="menuitem" class="col-4">
                                    <a
                                        class="dropdown-item"
                                        role="menuitem"
                                        type="edit"
                                    >Edit</a>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="card">
                        <div
                            t-attf-class="#{kanban_color(record.color.raw_value)} oe_kanban_global_click"
                            name="lims_equipment"
                        >
                            <div class="oe_kanban_content">
                                <div>
                                    <strong class="o_kanban_record_title">
                                        <field name="name" />
                                    </strong>
                                </div>
                                <div>
                                    <field
                                        name="tag_ids"
                                        widget="many2many_tags"
                                        groups="lims.group_lims_tag"
                                        options="{'color_field': 'color'}"
                                    />
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field
                                            name="priority"
                                            widget="priority"
                                            groups="lims.group_lims_user"
                                        />
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field
                                            name="operator_id"
                                            widget="many2one_avatar_user"
                                        />
                                    </div>
                                </div>
                            </div>
                            <div class="oe_clear" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search for lims.order-->
    <record id="lims_order_search_view" model="ir.ui.view">
        <field name="name">lims.order.search</field>
        <field name="model">lims.order</field>
        <field name="arch" type="xml">
            <search string="Orders">
                <filter
                    string="My Orders"
                    domain="[('operator_id.user_ids', '=', uid)]"
                    name="my_orders"
                />
                <separator />
                <field
                    name="name"
                    filter_domain="['|', ('name', 'ilike', self), ('name', '=like', str(self) + '%')]"
                    string="LIMS Order Name"
                />
                <field name="team_id" groups="lims.group_lims_team" />
                <field name="operator_id" />
                <separator />
                <filter
                    string="To Do"
                    domain="[('stage_id.is_closed', '=', False)]"
                    name="todo"
                />
                <filter
                    string="Unassigned"
                    domain="[('operator_id', '=', False), ('stage_id.is_closed', '=', False)]"
                    name="unassigned"
                />
                <filter
                    string="Unscheduled"
                    domain="[('scheduled_date', '=', False), ('stage_id.is_closed', '=', False)]"
                    name="unscheduled"
                />
                <filter
                    string="Done"
                    domain="[('stage_id.is_closed', '=', True)]"
                    name="done"
                />
                <separator />
                <filter
                    string="Today Orders"
                    domain="[
                    ('scheduled_date', '&gt;=', (datetime.datetime.combine(datetime.date.today(), datetime.time(0,0,0)))),
                    ('scheduled_date', '&lt;', (datetime.datetime.combine(datetime.date.today(), datetime.time(23,59,59))))
                    ]"
                    name="order_today"
                />
                <filter
                    string="Future Orders"
                    domain="[('scheduled_date', '&gt;=', (datetime.datetime.combine(datetime.date.today(), datetime.time(0,0,0))))]"
                    name="order_upcoming_all"
                />
                <filter
                    string="Due Within 7 Days"
                    domain="[
                    ('scheduled_date', '&gt;=', (datetime.datetime.combine(datetime.date.today(), datetime.time(0,0,0)))),
                    ('scheduled_date', '&lt;=', (datetime.datetime.combine((datetime.date.today()+relativedelta(days=6)), datetime.time(23,59,59))))
                    ]"
                    name="order_upcoming_week"
                />
                <filter
                    string="Due Within 30 Days"
                    domain="[
                    ('scheduled_date', '&gt;=',(datetime.datetime.combine(datetime.date.today(), datetime.time(0,0,0)))),
                    ('scheduled_date', '&lt;=', (datetime.datetime.combine((datetime.date.today()+relativedelta(days=29)), datetime.time(23,59,59))))
                    ]"
                    name="order_upcoming_month"
                />
                <separator />
                <group expand="0" string="Group By">
                    <filter
                        name="lims_operator_id"
                        domain=""
                        context="{'group_by':'operator_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="lims_order_calendar_view" model="ir.ui.view">
        <field name="name">Analysis</field>
        <field name="model">lims.order</field>
        <field name="type">calendar</field>
        <field name="arch" type="xml">
            <calendar string="Analysis" date_start="scheduled_date" color="stage_id">
                <field name="name" />
                <field name="stage_id" filters="1" />
                <field name="operator_id" avatar_field="image_128" />
                <field name="team_id" filters="1" />
            </calendar>
        </field>
    </record>

    <record id="action_lims_dash_order" model="ir.actions.act_window">
        <field name="name">Analysis</field>
        <field name="res_model">lims.order</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="search_view_id" ref="lims_order_search_view" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an Analysis.
            </p>
        </field>
    </record>

    <!-- Reporting -->
    <record id="lims_order_graph_view" model="ir.ui.view">
        <field name="name">lims.order.graph</field>
        <field name="model">lims.order</field>
        <field name="arch" type="xml">
            <graph string="Service Orders" type="bar">
                <field name="stage_id" type="row" />
            </graph>
        </field>
    </record>

    <record id="lims_order_pivot_view" model="ir.ui.view">
        <field name="name">lims.order.pivot</field>
        <field name="model">lims.order</field>
        <field name="arch" type="xml">
            <pivot string="Service Orders" display_quantity="true">
                <field name="stage_id" type="row" />
            </pivot>
        </field>
    </record>

    <record id="action_lims_report_order" model="ir.actions.act_window">
        <field name="name">Analysis</field>
        <field name="res_model">lims.order</field>
        <field name="view_mode">graph,pivot</field>
        <field name="help" type="html">
            <p>Analysis Reports.</p>
        </field>
    </record>

    <record id="action_report_lims_order" model="ir.actions.report">
        <field name="name">Analysis</field>
        <field name="model">lims.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lims.report_lims_order</field>
        <field name="report_file">lims.report_lims_order</field>
        <field name="print_report_name">'Analysis - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_lims_order" />
    </record>
</odoo>
