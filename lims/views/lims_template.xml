<odoo>
    <!-- LIMS Template -->
    <record id="lims_template_list_view" model="ir.ui.view">
        <field name="name">Order Templates</field>
        <field name="model">lims.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="operator_id" />
                <field name="physician_id" />
                <field
                    name="category_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    groups="lims.group_lims_category"
                />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="lims_template_form_view" model="ir.ui.view">
        <field name="name">Order Template</field>
        <field name="model">lims.template</field>
        <field name="arch" type="xml">
            <form string="template">
                <sheet>
                    <label for="name" class="oe_edit_only" />
                    <h1>
                        <field name="name" />
                    </h1>
                    <group>
                        <group>
                            <field name="operator_id" />
                        </group>
                        <group>
                            <field
                                name="category_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color'}"
                                groups="lims.group_lims_category"
                            />
                            <field
                                name="company_id"
                                options="{'no_create': True}"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Tests" name="tests">
                            <field name="test_ids" nolabel="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_lims_template" model="ir.actions.act_window">
        <field name="name">Order Templates</field>
        <field name="res_model">lims.template</field>
        <field name="view_id" ref="lims_template_list_view" />
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an analysis template
            </p>
        </field>
    </record>
</odoo>
