<odoo>
    <!-- LIMS Specimen -->
    <record id="lims_specimen_list" model="ir.ui.view">
        <field name="name">lims.specimen.list</field>
        <field name="model">lims.specimen</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="stage_id" />
            </list>
        </field>
    </record>

    <record id="lims_specimen_form" model="ir.ui.view">
        <field name="name">lims.specimen.form</field>
        <field name="model">lims.specimen</field>
        <field name="arch" type="xml">
            <form string="Specimen">
                <header>
                    <button
                        id="previous_stage"
                        name="previous_stage"
                        string="Previous Stage"
                        class="oe_highlight"
                        type="object"
                        groups="lims.group_lims_user"
                    />
                    <button
                        id="next_stage"
                        name="next_stage"
                        string="Next Stage"
                        class="oe_highlight"
                        type="object"
                        groups="lims.group_lims_user"
                    />
                    <field
                        name="stage_id"
                        widget="statusbar"
                        domain="[('stage_type', '=', 'specimen')]"
                    />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box" />
                    <label for="name" class="oe_edit_only" />
                    <h1>
                        <field name="name" required="True" />
                    </h1>
                    <group>
                        <group />
                        <group />
                    </group>
                    <notebook />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_lims_specimen" model="ir.actions.act_window">
        <field name="name">Specimen</field>
        <field name="res_model">lims.specimen</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add Specimen here.
            </p>
        </field>
    </record>
</odoo>
