<odoo>
    <record model="ir.ui.view" id="lims_sample_form_view">
        <field name="name">lims.sample.form (in lims)</field>
        <field name="model">lims.sample</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="receive_sample_action"
                        type="object"
                        string="Receive"
                        class="btn-primary"
                        invisible="is_closed or received_date"
                    />
                    <button
                        name="action_next_workflow_stage"
                        type="object"
                        string="Next Stage"
                        invisible="is_closed or not stage_id"
                    />
                    <field
                        name="stage_id"
                        widget="statusbar"
                        options="{'fold_field': 'fold'}"
                        readonly="1"
                    />
                </header>
                <sheet>
                    <field name="is_closed" invisible="1" />
                    <field name="is_default_stage" invisible="1" />
                    <div name="button_box" class="oe_button_box" />
                    <div class="oe_title">
                        <label for="identifier" />
                        <h1>
                            <field name="identifier" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Sample Information">
                            <field name="customer_id" />
                            <field
                                name="sample_type_id"
                                readonly="not is_default_stage"
                            />
                            <field name="external_identifier" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group string="Dates &amp; Status">
                            <field name="sample_date" readonly="not is_default_stage" />
                            <field name="received_date" readonly="1" />
                            <field name="priority" widget="priority" />
                            <field name="progress" widget="progressbar" />
                        </group>
                    </group>
                    <notebook>
                        <page name="analysis" string="Analysis">
                            <field name="analysis_ids" />
                        </page>
                        <page name="interpretation" string="Interpretation">
                            <field name="interpretation" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record model="ir.ui.view" id="lims_sample_search_view">
        <field name="name">lims.sample.search (in lims)</field>
        <field name="model">lims.sample</field>
        <field name="arch" type="xml">
            <search>
                <field name="identifier" />
                <field name="external_identifier" />
                <field name="sample_type_id" />
                <field name="sample_date" />
                <field name="customer_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <filter
                    name="open"
                    string="Open"
                    domain="[('is_closed', '=', False)]"
                />
                <filter
                    name="closed"
                    string="Closed"
                    domain="[('is_closed', '=', True)]"
                />
                <group expand="1" string="Group By">
                    <filter
                        name="group_stage"
                        string="Stage"
                        context="{'group_by': 'stage_id'}"
                    />
                    <filter
                        name="group_sample_type"
                        string="Sample Type"
                        context="{'group_by': 'sample_type_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record model="ir.ui.view" id="lims_sample_list_view">
        <field name="name">lims.sample.list (in lims)</field>
        <field name="model">lims.sample</field>
        <field name="arch" type="xml">
            <list>
                <field name="identifier" />
                <field name="customer_id" />
                <field name="sample_type_id" />
                <field name="sample_date" />
                <field name="received_date" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="progress" widget="progressbar" />
                <field name="stage_id" />
            </list>
        </field>
    </record>
    <record model="ir.actions.act_window" id="lims_sample_act_window">
        <field name="name">Samples</field>
        <field name="res_model">lims.sample</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
</odoo>
