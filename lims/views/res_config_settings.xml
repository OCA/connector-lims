<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.lims</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="LIMS"
                    string="LIMS"
                    name="lims"
                    groups="lims.group_lims_manager"
                >
                    <block title="Advanced Features" name="advanced_features_container">
                        <setting
                            string="LIMS Advanced"
                            help="Enable advanced LIMS features: LOINC, stages, teams, instruments, batches and order workflow"
                        >
                            <field name="module_lims_advanced" />
                        </setting>
                        <setting
                            string="Units of Measure"
                            help="Use different units of measure for analysis results"
                        >
                            <field name="group_uom" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_lims_config" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'lims'}</field>
    </record>
</odoo>
