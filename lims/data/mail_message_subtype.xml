<odoo noupdate="1">
    <!-- Analysis related subtypes for messaging / Chatter -->
    <record id="mt_order_new" model="mail.message.subtype">
        <field name="name">Analysis Created</field>
        <field name="sequence">0</field>
        <field name="res_model">lims.order</field>
        <field name="default" eval="False" />
        <field name="hidden" eval="True" />
        <field name="description">Analysis created</field>
    </record>
    <record id="mt_order_confirmed" model="mail.message.subtype">
        <field name="name">Analysis Confirmed</field>
        <field name="sequence">10</field>
        <field name="res_model">lims.order</field>
        <field name="default" eval="False" />
        <field name="internal" eval="True" />
        <field name="description">Analysis confirmed</field>
    </record>
    <record id="mt_order_scheduled" model="mail.message.subtype">
        <field name="name">Analysis Scheduled</field>
        <field name="sequence">20</field>
        <field name="res_model">lims.order</field>
        <field name="default" eval="False" />
        <field name="internal" eval="True" />
        <field name="description">Analysis scheduled</field>
    </record>
    <record id="mt_order_assigned" model="mail.message.subtype">
        <field name="name">Analysis Assigned</field>
        <field name="sequence">30</field>
        <field name="res_model">lims.order</field>
        <field name="default" eval="False" />
        <field name="internal" eval="True" />
        <field name="description">Analysis assigned</field>
    </record>
    <record id="mt_order_started" model="mail.message.subtype">
        <field name="name">Analysis Started</field>
        <field name="sequence">40</field>
        <field name="res_model">lims.order</field>
        <field name="default" eval="False" />
        <field name="internal" eval="True" />
        <field name="description">Analysis started</field>
    </record>
    <record id="mt_order_completed" model="mail.message.subtype">
        <field name="name">Analysis Completed</field>
        <field name="sequence">50</field>
        <field name="res_model">lims.order</field>
        <field name="default" eval="False" />
        <field name="internal" eval="True" />
        <field name="description">Analysis completed</field>
    </record>
    <record id="mt_order_cancelled" model="mail.message.subtype">
        <field name="name">Analysis Cancelled</field>
        <field name="sequence">100</field>
        <field name="res_model">lims.order</field>
        <field name="default" eval="False" />
        <field name="internal" eval="True" />
        <field name="description">Analysis cancelled</field>
    </record>
</odoo>
