<odoo noupdate="1">
    <!-- Sample Stages -->
    <record id="lims_stage_sample_registered" model="lims.stage">
        <field name="name">Registered</field>
        <field name="sequence">5</field>
        <field name="is_default">True</field>
        <field name="stage_type">sample</field>
    </record>

    <record id="lims_stage_sample_scheduled_sampling" model="lims.stage">
        <field name="name">Scheduled Sampling</field>
        <field name="sequence">10</field>
        <field name="stage_type">sample</field>
    </record>

    <record id="lims_stage_sample_due" model="lims.stage">
        <field name="name">Sample due</field>
        <field name="sequence">15</field>
        <field name="stage_type">sample</field>
    </record>

    <record id="lims_stage_sample_received" model="lims.stage">
        <field name="name">Received</field>
        <field name="sequence">20</field>
        <field name="stage_type">sample</field>
    </record>

    <record id="lims_stage_sample_to_be_verified" model="lims.stage">
        <field name="name">To be verified</field>
        <field name="sequence">30</field>
        <field name="stage_type">sample</field>
    </record>

    <record id="lims_stage_sample_verified" model="lims.stage">
        <field name="name">Verified</field>
        <field name="sequence">40</field>
        <field name="stage_type">sample</field>
    </record>

    <record id="lims_stage_sample_published" model="lims.stage">
        <field name="name">Published</field>
        <field name="sequence">50</field>
        <field name="is_closed">True</field>
        <field name="stage_type">sample</field>
    </record>

    <record id="lims_stage_sample_cancelled" model="lims.stage">
        <field name="name">Cancelled</field>
        <field name="sequence">60</field>
        <field name="fold">True</field>
        <field name="is_closed">True</field>
        <field name="stage_type">sample</field>
    </record>

    <record id="lims_stage_sample_invalid" model="lims.stage">
        <field name="name">Invalid</field>
        <field name="sequence">70</field>
        <field name="fold">True</field>
        <field name="is_closed">True</field>
        <field name="stage_type">sample</field>
    </record>

    <!-- Analysis Stages -->
    <record id="lims_stage_analysis_registered" model="lims.stage">
        <field name="name">Registered</field>
        <field name="sequence">5</field>
        <field name="stage_type">result</field>
    </record>

    <record id="lims_stage_analysis_to_analyze" model="lims.stage">
        <field name="name">To Analyze</field>
        <field name="sequence">10</field>
        <field name="stage_type">result</field>
    </record>

    <record id="lims_stage_analysis_to_be_verified" model="lims.stage">
        <field name="name">To be Verified</field>
        <field name="sequence">20</field>
        <field name="stage_type">result</field>
    </record>

    <record id="lims_stage_analysis_verified" model="lims.stage">
        <field name="name">Verified</field>
        <field name="sequence">30</field>
        <field name="is_closed">True</field>
        <field name="stage_type">result</field>
    </record>

    <record id="lims_stage_analysis_rejected" model="lims.stage">
        <field name="name">Rejected</field>
        <field name="sequence">40</field>
        <field name="fold">True</field>
        <field name="is_closed">True</field>
        <field name="stage_type">result</field>
    </record>
</odoo>
