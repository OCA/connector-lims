<odoo>
    <record id="view_test_form" model="ir.ui.view">
        <field name="name">lims.test.form</field>
        <field name="model">lims.test</field>
        <field name="arch" type="xml">
            <form string="Test">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Test Name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="loinc_code_id" />
                            <field name="method_id" />
                            <field
                                name="instrument_id"
                                groups="lims_advanced.group_lims_instrument"
                            />
                        </group>
                        <group>
                            <field
                                name="company_id"
                                options="{'no_create': True}"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page name="description" string="Description">
                            <field name="description" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_test_list" model="ir.ui.view">
        <field name="name">lims.test.list</field>
        <field name="model">lims.test</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="loinc_code_id" />
                <field name="method_id" />
                <field
                    name="instrument_id"
                    groups="lims_advanced.group_lims_instrument"
                />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="action_lims_test" model="ir.actions.act_window">
        <field name="name">Tests</field>
        <field name="res_model">lims.test</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new test</p>
        </field>
    </record>
</odoo>
