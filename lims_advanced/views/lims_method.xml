<odoo>
    <record id="view_method_form" model="ir.ui.view">
        <field name="name">lims.method.form</field>
        <field name="model">lims.method</field>
        <field name="arch" type="xml">
            <form string="Method">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Method Name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group name="method">
                        <group name="method-left">
                            <field name="partner_id" />
                        </group>
                        <group name="method-right" />
                    </group>
                    <notebook>
                        <page name="description" string="Description">
                            <field name="description" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_method_list" model="ir.ui.view">
        <field name="name">lims.method.list</field>
        <field name="model">lims.method</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="partner_id" />
            </list>
        </field>
    </record>

    <record id="action_lims_method" model="ir.actions.act_window">
        <field name="name">Methods</field>
        <field name="res_model">lims.method</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new method.</p>
        </field>
    </record>
</odoo>
