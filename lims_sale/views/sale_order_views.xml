<odoo>
    <record id="view_order_form_inherit_lims_sale" model="ir.ui.view">
        <field name="name">sale.order.form.lims.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet//div[@name='button_box']" position="inside">
                <button
                    name="action_view_lims_orders"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-flask"
                    invisible="lims_order_count == 0"
                >
                    <field
                        name="lims_order_count"
                        widget="statinfo"
                        string="LIMS Orders"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
