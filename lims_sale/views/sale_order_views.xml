<odoo>
    <record id="view_order_form_inherit_lims_sale" model="ir.ui.view">
        <field name="name">sale.order.form.lims.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']//list//field[@name='product_id']"
                position="after"
            >
                <field
                    name="lims_analyte_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                    invisible="not product_id"
                />
            </xpath>
            <xpath expr="//sheet//div[@name='button_box']" position="inside">
                <button
                    name="action_view_lims_samples"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-flask"
                    invisible="lims_sample_count == 0"
                >
                    <field
                        name="lims_sample_count"
                        widget="statinfo"
                        string="LIMS Samples"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
