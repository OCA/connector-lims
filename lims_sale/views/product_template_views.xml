<odoo>
    <record id="view_product_template_form_lims_sale" model="ir.ui.view">
        <field name="name">product.template.form.lims.sale</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group string="LIMS" name="lims_sale">
                    <field name="lims_tracking" />
                    <field
                        name="lims_sample_type_id"
                        invisible="lims_tracking == 'no'"
                        required="lims_tracking != 'no'"
                    />
                    <field
                        name="lims_analyte_ids"
                        widget="many2many_tags"
                        invisible="lims_tracking == 'no'"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
