<odoo>
    <record id="view_lims_sample_form_inherit_sale" model="ir.ui.view">
        <field name="name">lims.sample.form.inherit.sale</field>
        <field name="model">lims.sample</field>
        <field name="inherit_id" ref="lims.lims_sample_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_sale_order"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart"
                    invisible="not sale_order_id"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Sale Order</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sale_order_id" readonly="1" />
                <field name="sale_origin" readonly="1" />
            </xpath>
        </field>
    </record>
</odoo>
