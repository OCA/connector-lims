<odoo>
    <record id="view_lims_order_form_inherit" model="ir.ui.view">
        <field name="name">lims.order.form.inherit</field>
        <field name="model">lims.order</field>
        <field name="inherit_id" ref="lims.lims_order_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_open_account_moves"
                    icon="fa-pencil-square-o"
                    invisible="account_move_count == 0"
                >
                    <field
                        string="Invoices"
                        name="account_move_count"
                        widget="statinfo"
                    />
                </button>
            </div>
            <page name="other_info" position="after">
                <page string="Accounting" name="accounting">
                    <group name="Accounting" string="Accounting">
                        <field name="account_move_ids" nolabel="1" />
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
