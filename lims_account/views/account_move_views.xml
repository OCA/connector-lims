<odoo>
    <record id="view_move_form_inherit_lims" model="ir.ui.view">
        <field name="name">account.move.form.inherit.lims</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_lims_samples"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-flask"
                    invisible="lims_sample_count == 0"
                >
                    <field
                        name="lims_sample_count"
                        widget="statinfo"
                        string="LIMS Samples"
                    />
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id'][1]" position="after">
                <field
                    name="lims_sample_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                />
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']//list//field[@name='name']"
                position="after"
            >
                <field
                    name="lims_analyte_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>
</odoo>
