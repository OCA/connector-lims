<odoo>
    <record id="view_product_template_form_inherit_lims_stock" model="ir.ui.view">
        <field name="name">product.template.form.lims.stock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex">
                    <field name="is_specimen" />
                    <label for="is_specimen" />
                </span>
            </xpath>
        </field>
    </record>
</odoo>
